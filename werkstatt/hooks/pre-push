#!/usr/bin/env bash
# Vor jedem Push: Gegenproben der Prüfung, dann Handyformat (braucht Playwright, ~1 min).
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 werkstatt/seite_pruefen.py --gegenproben || exit 1
NODE_PATH="${NODE_PATH:-$(npm root -g)}" node werkstatt/seite_handy.js || { echo "Push abgelehnt: Handyprüfung rot."; exit 1; }
